{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Writing",
  "type": "object",
  "required": ["writings"],
  "properties": {
    "writings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "text", "visibility", "language", "slug"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "text": { "type": "string" },
          "topics": {
            "type": "array",
            "items": { "type": "string" }
          },
          "edition": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string" },
              "number": { "type": ["number", "null"] }
            }
          },
          "exhibition": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "year": { "type": "number" }
            }
          },
          "imageGallery": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url"],
              "properties": {
                "id": { "type": "string" },
                "url": { "type": "string" },
                "alt": { "type": "string" },
                "order": { "type": "number" }
              }
            }
          },
          "visibility": {
            "type": "string",
            "enum": ["public", "private"]
          },
          "language": {
            "type": "string",
            "enum": ["es", "en", "eu"]
          },
          "relatedArtworks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "slug": { "type": "string" },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        }
      }
    }
  }
}
