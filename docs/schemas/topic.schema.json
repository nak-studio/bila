{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Topic",
  "type": "object",
  "required": ["topics"],
  "properties": {
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slug"],
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
