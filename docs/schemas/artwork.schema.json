{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artwork",
  "type": "object",
  "required": ["artworks"],
  "properties": {
    "artworks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "images", "visibility", "language", "slug"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "medium": {
            "type": "array",
            "items": { "type": "string" }
          },
          "topics": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dimensions": {
            "type": "object",
            "required": ["width", "height", "unit"],
            "properties": {
              "width": { "type": "number" },
              "height": { "type": "number" },
              "unit": { "type": "string", "enum": ["cm", "mm", "in"] }
            }
          },
          "edition": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string" },
              "number": { "type": ["number", "null"] }
            }
          },
          "exhibition": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "year": { "type": "number" }
            }
          },
          "images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["url"],
              "properties": {
                "id": { "type": "string" },
                "url": { "type": "string" },
                "alt": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["main", "detail", "process", "framed"]
                },
                "order": { "type": "number" }
              }
            }
          },
          "status": {
            "type": "string",
            "enum": ["available", "sold", "reserved", "private"]
          },
          "price": {
            "type": "object",
            "properties": {
              "amount": { "type": "number" },
              "currency": { "type": "string" }
            }
          },
          "visibility": {
            "type": "string",
            "enum": ["public", "private"]
          },
          "language": {
            "type": "string",
            "enum": ["es", "en", "eu"]
          },
          "relatedWritings": {
            "type": "array",
            "items": { "type": "string" }
          },
          "slug": { "type": "string" },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        }
      }
    }
  }
}
